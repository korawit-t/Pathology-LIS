# =================================================================
# ENVIRONMENT
# =================================================================
# Controls Secure-cookie flag, strict CORS validation, and whether
# /docs / /redoc / /openapi.json are served.
#
# "development" — Plain HTTP cookies, Swagger UI enabled, relaxed CORS.
#                 Use for:
#                   • Local development on localhost
#                   • Hospital LAN deployments that do not yet use HTTPS
#                     (e.g. serving the app at http://192.168.x.x)
#
# "production"  — Secure cookies (HTTPS only), strict CORS (blocks http:// origins),
#                 Swagger UI disabled.
#                 Use for: internet-facing deployments with a valid TLS certificate.
#
# ⚠️  If you run on a hospital LAN over plain HTTP, keep ENVIRONMENT=development.
#     Setting production will cause the server to refuse to start because
#     ALLOWED_ORIGINS will contain http:// origins.
#
# Default (unset) = "production". Fail-closed by design.
ENVIRONMENT=development

# =================================================================
# DATABASE CONFIGURATION
# =================================================================
# Format: postgresql+psycopg2://USER:PASSWORD@HOST:5432/DB_NAME
# In Docker use the service name 'db' instead of localhost.
# After first-time setup, switch to the least-privilege role:
#   DATABASE_URL=postgresql+psycopg2://lis_app_rw:<LIS_APP_PASSWORD>@db:5432/<POSTGRES_DB>
DATABASE_URL=postgresql+psycopg2://lisuser:CHANGE_ME@db:5432/pathology_lis

# =================================================================
# SECURITY & AUTHENTICATION
# =================================================================
# REQUIRED — generate with: openssl rand -hex 32
# The server will refuse to start if this is missing, shorter than 32 chars,
# or still set to this placeholder value.
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=3

# =================================================================
# CORS & NETWORK
# =================================================================
# Comma-separated list of allowed frontend origins — must match exactly what
# users type in the browser (scheme + host + port).
#
# Hospital LAN example (ENVIRONMENT=development):
#   ALLOWED_ORIGINS=http://192.168.0.190,http://localhost:5173
#   Note: if the frontend is served on port 80, omit the port entirely.
#         If served on another port, include it: http://192.168.0.190:3000
#
# Internet / cloud example (ENVIRONMENT=production):
#   ALLOWED_ORIGINS=https://lis.myhospital.go.th
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://192.168.1.100

# Optional. Only needed when the frontend and backend are on DIFFERENT
# subdomains of the SAME custom domain (e.g. app.mylis.example.com serving
# the frontend, api.mylis.example.com serving this backend). Set to the
# shared parent domain so the auth cookie is sent to both — without this,
# Safari (and eventually Chrome) will silently block the cookie as
# third-party/cross-site and every request will 401 after login.
# Leave unset for LAN-only or single-host deployments.
#   COOKIE_DOMAIN=.mylis.example.com
COOKIE_DOMAIN=

# SameSite policy for the auth cookies. Controls the browser-level CSRF defense.
#   lax    (default) — cookie NOT sent on cross-site requests. Use this whenever
#                      the frontend and backend are the SAME site:
#                        • on-prem: SPA and API served from the same host, and
#                        • the Railway build that reverse-proxies the API through
#                          the frontend nginx (nginx.railway.conf.template) so it
#                          is same-origin.
#   none             — cookie IS sent cross-site. Needed ONLY when the frontend
#                      and backend are on genuinely different sites (e.g. two
#                      separate Railway services on distinct *.up.railway.app
#                      hostnames). Requires ENVIRONMENT=production (Secure/HTTPS),
#                      or the server refuses to start. Don't set "none" unless you
#                      actually need it — it needlessly opens CSRF.
#   strict           — most restrictive; rarely needed.
COOKIE_SAMESITE=lax

# IP/CIDR of the reverse proxy that sits directly in front of THIS backend.
# The backend trusts X-Forwarded-For only from these hops — this drives both
# the audit-log client IP AND the per-IP login rate limiter. If it's wrong,
# every request looks like it comes from the proxy, so the login limiter
# collapses into one global bucket (one brute-forcer throttles everyone) and
# audit IPs are all identical. Comma-separate multiple entries.
#   • on-prem, TLS-terminating nginx/Caddy/Traefik on the SAME host as backend:
#       TRUSTED_PROXY_IPS=127.0.0.1
#   • on-prem proxy on a different host/container: use that host's IP or CIDR.
#   • Railway: the immediate hop is Railway's edge/private-network proxy, whose
#       IP is dynamic — there is no stable value to trust here, so per-IP rate
#       limiting on Railway is best-effort. Keep the default and rely on the
#       account-lockout counter, or front the service with your own proxy.
TRUSTED_PROXY_IPS=127.0.0.1

# =================================================================
# HIS INTEGRATION (Hospital Information System)
# =================================================================
# Set HIS_TYPE to the HIS vendor your hospital uses.
# Currently supported: "hosxp"  |  Leave blank to disable HIS integration.
HIS_TYPE=hosxp

# Connection string for the HIS database (read-only recommended).
# Format: mysql+pymysql://USER:PASSWORD@HOST:3306/DB_NAME?charset=utf8
HIS_DATABASE_URL=mysql+pymysql://lisuser:password@192.168.1.200:3306/hos?charset=utf8

# HOSxP order-form names used to match incoming orders to case types.
# Change these to match the exact form names configured in your HOSxP instance.
HOSXP_FORM_SURGICAL=Pathology
HOSXP_FORM_GYNE=PAP smear, liquid based cytology and HPV testing
HOSXP_FORM_NONGYNE=FNA, Body fluid cytology

# =================================================================
# OUTBOUND HIS EXPORT (Optional) — send finalized reports back out to a HIS
# =================================================================
# See backend/app/his_export/README.md for the full adapter contract.
# Currently supported: "none" (default, disabled) | "generic_webhook" | "custom"
# HL7v2/MLLP and FHIR are documented extension points, not yet implemented.
HIS_EXPORT_TYPE=none

# Whether to render and attach the report PDF (base64) alongside structured
# fields. Off by default since PDF rendering is the most expensive step.
HIS_EXPORT_INCLUDE_PDF=false

# Worker tuning (in-process asyncio loop — no separate worker process/container).
HIS_EXPORT_POLL_INTERVAL_SECONDS=15
HIS_EXPORT_BATCH_SIZE=10
HIS_EXPORT_MAX_ATTEMPTS=8
HIS_EXPORT_BACKOFF_BASE_SECONDS=60
HIS_EXPORT_BACKOFF_MAX_SECONDS=3600
HIS_EXPORT_STALE_PROCESSING_SECONDS=300

# generic_webhook adapter settings (only used when HIS_EXPORT_TYPE=generic_webhook).
# Typically an on-LAN interface engine (Mirth, Rhapsody, etc.) — http and
# private IPs are both fine here, unlike the Slack/LINE notification webhooks.
HIS_EXPORT_WEBHOOK_URL=
HIS_EXPORT_WEBHOOK_AUTH_HEADER=Authorization
HIS_EXPORT_WEBHOOK_AUTH_TOKEN=
HIS_EXPORT_WEBHOOK_TIMEOUT_SECONDS=15

# =================================================================
# AI / LLM INTEGRATION (Optional)
# =================================================================
# API keys per provider — stored here only, never in the database.
# LLM profiles (name, model, base_url) are configured via System Settings UI.
# Leave blank to disable AI features for that provider.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_COMPATIBLE_API_KEY=   # Azure OpenAI, Gemini, Ollama, or any OpenAI-compatible endpoint

# =================================================================
# GOOGLE CALENDAR INTEGRATION (Optional)
# =================================================================
# Used for Pathologist schedule / holiday sync.
# Leave blank to disable.
GOOGLE_CALENDAR_API_KEY=


# =================================================================
# BACKUP CONFIGURATION (Optional)
# =================================================================
# Slack Incoming Webhook URL for backup success/failure notifications.
# Leave blank to disable Slack alerts.
SLACK_BACKUP_WEBHOOK=

# Root directory where backup files are written.
# Windows example: D:\pathology_backup
# Linux example:   /media/ubuntu/PATHOLOGY_BK/pathology_backup
BACKUP_ROOT=

# (Windows only) Full path to the PostgreSQL bin folder containing pg_dump.exe
# Not needed on Linux/Docker — pg_dump runs inside the container.
# Example: C:\Program Files\PostgreSQL\15\bin
BACKUP_PG_BIN=

# (Linux/Docker only) Name of the Docker container running PostgreSQL.
# Defaults to "pathology-db" if not set.
# DB_CONTAINER=pathology-db

# Path to the uploaded files directory (images, attachments, etc.)
# Defaults to backend\uploads (Windows) or backend/uploads (Linux) if not set.
# STORAGE_DIR=C:\New LIS\Pathology_LIS\backend\uploads

# Note: backups overwrite the previous file every night (db_latest.dump / storage_latest.zip).
# Only one version is kept to save disk space.
