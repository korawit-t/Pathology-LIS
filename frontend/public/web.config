<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- API Reverse Proxy: forward /api/* to the FastAPI backend on the same
             host, stripping the /api prefix (so /api/auth/login -> :8000/auth/login).
             MUST come before the SPA rule. This file is copied into dist/ on every
             `npm run build` and overwrites the deployed web.config, so the rule
             lives HERE (in source) — a hand-added rule on the server gets wiped on
             the next deploy. NOTE: this only takes effect if IIS ARR (Application
             Request Routing) is installed and "Enable proxy" is ON at the server
             level; that setting lives in applicationHost.config and persists across
             redeploys. On nginx/Railway builds this file is simply ignored. -->
        <rule name="API Reverse Proxy" stopProcessing="true">
          <match url="^api/(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8000/{R:1}" appendQueryString="true" />
        </rule>

        <!-- SPA Rewrite Rule -->
        <rule name="React Routes" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <!-- Do not rewrite if the file or directory actually exists -->
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <!-- (Optional) Do not rewrite API requests if hosted together -->
            <add input="{REQUEST_URI}" pattern="^/(api)" negate="true" />
          </conditions>
          <!-- Rewrite all other requests to index.html -->
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>
    <!-- Handle static file caching -->
    <staticContent>
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="application/font-woff" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
    </staticContent>
  </system.webServer>

  <!-- index.html names the hashed JS/CSS of the build it came from, so the
       browser must ask for it again on every load: Cache-Control: no-cache
       (revalidate; an unchanged file still answers 304). Left to heuristic
       caching, a tab opened after a redeploy can get yesterday's index.html,
       whose chunks the new build has already deleted. The SPA rule above
       rewrites every route to /index.html, so this covers them too.
       version.json is what open tabs poll to notice a new build. -->
  <location path="index.html">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="version.json">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
