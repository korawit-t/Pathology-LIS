# =================================================================
# DOCKER COMPOSE — DATABASE CONTAINER (production)
# =================================================================
# Copy to `.env` in the repository root (next to docker-compose.yml):
#   cp .env.example .env
#
# docker compose reads this file by itself. It is needed only for the
# production stack (`docker compose -f docker-compose.yml ...`); the dev
# override supplies its own values, and an on-premise Windows install without
# Docker does not use it at all.
#
# Everything else the backend reads lives in backend/.env. The two files must
# agree on the database: backend/.env's DATABASE_URL has to name a user,
# password and database that exist here.
#
# Use letters and digits for the passwords (e.g. `openssl rand -hex 24`):
# docker-compose.yml builds a connection URL from them, characters such as
# @ : / # would break it, and compose reads a `$` in this file as the start of
# a variable.

# The database owner. The `migrate` service runs Alembic as this account.
POSTGRES_USER=lisuser
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=pathology_lis

# Password for the least-privilege role lis_app_rw (SELECT/INSERT/UPDATE/
# DELETE only), which backend/db/init-db.sh creates when the database volume
# is first initialised. Once it exists, backend/.env may connect as it:
#   DATABASE_URL=postgresql+psycopg2://lis_app_rw:<this password>@db:5432/<POSTGRES_DB>
# Migrations keep running as POSTGRES_USER. Leave empty to skip the role.
# Setting it after the volume already exists does nothing; see init-db.sh.
LIS_APP_PASSWORD=

# =================================================================
# PROJECT NAME
# =================================================================
# Docker names the volumes holding the database and the uploads after the
# project: pathology-lis_postgres_data, pathology-lis_uploads_data. Unset, the
# project is named after the folder, so renaming or moving the folder makes
# the next `up` start on new, EMPTY volumes (the old ones are still there, just
# no longer used). Set here, the name stays put wherever the folder goes.
#
# pathology-lis is the name a plain `git clone` of the repository gets. An
# install that is already running must keep the name it already has: look for
# <name>_postgres_data in `docker volume ls` and put that <name> here.
COMPOSE_PROJECT_NAME=pathology-lis

# =================================================================
# PORTS (optional)
# =================================================================
# The ports the server publishes. Change one only if it is already taken.
# Each also appears in another file, which has to match:
#   FRONTEND_PORT  backend/.env  ALLOWED_ORIGINS=http://<server-ip>:<FRONTEND_PORT>
#   BACKEND_PORT   frontend/.env VITE_API_BASE_URL=http://<server-ip>:<BACKEND_PORT>
#                  (baked into the frontend: rebuild with `up -d --build`)
# FRONTEND_PORT=3000
# BACKEND_PORT=8000
# Dev override only: the port the dev database is published on.
# DB_PORT=5432

# =================================================================
# WHOLE-SLIDE IMAGES (optional)
# =================================================================
# The folder on this server where the slide scanner saves its files. It is
# mounted read-only into the backend at /wsi: set the WSI Root Path in
# System Settings → WSI Settings to /wsi, not to this path. Use an absolute
# path, with forward slashes on Windows too (Linux /mnt/scanner, Windows
# D:/WSI_Storage). A network share works on Linux once it is mounted on the
# server (e.g. cifs in /etc/fstab): give its mount point. Docker Desktop on
# Windows cannot bind a \\server\share path or a mapped drive.
# WSI_HOST_PATH=/mnt/scanner
